{
  // Codespaces şablonundan uyarlandı. Sürüm, dağıtımdaki Streamlit Cloud ile
  // AYNI tutulur (3.13); geliştirme yerelde 3.14 ile yapılıyor.
  "name": "pyCBA-UI",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "app.py"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  // requirements-dev.txt requirements.txt'i zaten içeriyor (-r ile) ve üstüne
  // pytest ekler; streamlit'i ayrıca kurmak sabitlenmiş sürümü (~=1.59.2)
  // ezeceği için YAPILMAZ.
  "updateContentCommand": "pip3 install --user -r requirements-dev.txt",
  "postAttachCommand": {
    "server": "python -m streamlit run app.py"
  },
  "portsAttributes": {
    "8501": {
      "label": "Application",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8501
  ]
}
