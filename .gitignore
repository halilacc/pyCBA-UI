# ---- Sanal ortam ----
# PyCBA fork edilmez, .venv içinden bağımlılık olarak import edilir.
# 7000+ dosya; asla depoya girmez. Kurulum: pip install -r requirements.txt
.venv/
venv/
env/
ENV/

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ---- Ortam değişkenleri / sırlar ----
# Proje ortam değişkeni OKUMUYOR; bu kurallar yine de dursun ki ileride bir
# .env doğarsa kazara izlenmesin.
.env
.env.*
*.key
*.pem
secrets.toml

# ---- Web ön yüzü (Next.js) ----
web/node_modules/
web/.next/
web/next-env.d.ts

# ---- Streamlit ----
.streamlit/secrets.toml

# ---- Örnek betiklerin ürettiği çıktılar ----
# ornek2_diyagram.py bir PNG üretir; izlenen bir örneği çalıştırmak çalışma
# ağacını kirletmesin. (docs/ altındaki ekran görüntüleri İZLENİR, bkz. aşağıda.)
cikti/

# ---- IDE / editör ----
.vscode/
.idea/
*.swp
*~

# ---- İşletim sistemi ----
.DS_Store
Thumbs.db
desktop.ini

